# Jurojin Social Reposter - Configuration
# Copiez ce fichier vers .env et remplissez vos cles API
# Ne commitez JAMAIS le fichier .env !

# === Twitter API (Direct) ===
# Creez une app sur https://developer.twitter.com/
# Activez OAuth 1.0a avec Read and Write permissions
TWITTER_API_KEY=your-api-key-here
TWITTER_API_SECRET=your-api-secret-here
TWITTER_ACCESS_TOKEN=your-access-token-here
TWITTER_ACCESS_TOKEN_SECRET=your-access-token-secret-here

# === Facebook Graph API ===
# Creez une app sur https://developers.facebook.com/
# Generez un Page Access Token avec permissions: pages_manage_posts, pages_read_engagement
FACEBOOK_PAGE_ID=your-page-id-here
FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token-here

# === Groq API (generation d'accroches) ===
# https://console.groq.com/
GROQ_API_KEY=your-api-key-here

# === Bluesky ===
# Creez un App Password sur https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=votre-handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# === WordPress REST API (pour TrendsToWordPress) ===
# Creez un App Password dans WordPress: Utilisateurs > Profil > Mots de passe d'application
WORDPRESS_USERNAME=your-username
WORDPRESS_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx-xxxx-xxxx
